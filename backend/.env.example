# LLM provider configuration (keep provider swappable; do not hard-code keys)
# LLM_PROVIDER=openai  |  ollama  |  gemini  |  openrouter  |  anthropic
# Primary provider: OpenRouter. If it fails (bad/missing key, exhausted rate limit, request
# error), run_structured_task automatically retries once against LLM_FALLBACK_PROVIDER below.
LLM_PROVIDER=openrouter
# OpenRouter's free-tier roster changes often — models get pulled with no warning (this project
# has hit meta-llama/llama-3.1-8b-instruct:free and z-ai/glm-5.2:free both go 404 "unavailable
# for free" in turn). Re-check openrouter.ai/models (filter by price=0) if this one 404s too;
# prefer a model with many independent hosting providers listed at
# openrouter.ai/api/v1/models/<id>/endpoints, since that spreads load across backends instead of
# hammering one shared pool. Also avoid "reasoning"/"thinking" models for this project's
# extraction tasks — qwen/qwen3.8-27b:free measured 10,016 hidden reasoning tokens (3+ min) on
# one real call versus 0 for this model; crewai_client.py passes reasoning_effort="none" as a
# cheap safety net regardless, but a non-reasoning model avoids paying for it at all.
LLM_MODEL=google/gemma-4-31b-it:free
LLM_FALLBACK_PROVIDER=gemini
# gemini-flash-latest tracks Google's current default Flash model, so it won't go stale the
# way a pinned version (gemini-2.0-flash, then gemini-3.6-flash) already has twice.
LLM_FALLBACK_MODEL=gemini-flash-latest
# Last-resort tier: if OpenRouter AND Gemini both fail (e.g. simultaneous free-tier outages),
# fall through to a local Ollama model. No rate limit and no cost, but slower and less accurate
# than the cloud tiers — only used when both of those are down. Requires `ollama serve` running
# locally with this model pulled (`ollama pull mistral:7b`). Leave both unset to skip this tier.
LLM_FALLBACK_PROVIDER_2=ollama
LLM_FALLBACK_MODEL_2=mistral:7b

OPENAI_API_KEY=your_openai_api_key_here

# Used only when LLM_PROVIDER=ollama (local models, no API key needed)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Fallback provider (cloud, fast — get a free key at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional: a second Gemini key (e.g. from a different Google account) to roughly double the
# effective free-tier rate-limit budget during Job Discovery. Calls round-robin between the two.
# Leave unset to use just GEMINI_API_KEY as before.
# GEMINI_API_KEY_2=your_second_gemini_api_key_here

# Primary provider (cloud, one key routes to many models — get a key at openrouter.ai/keys).
# Pick any model id OpenRouter lists at openrouter.ai/models (filter by price=0 for free ones —
# the roster changes often, so re-check there if this model ever 404s) or a paid one for
# higher throughput.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Used only when LLM_PROVIDER=anthropic (get a key at console.anthropic.com/settings/keys).
# PAID, pay-per-token — no free tier, no daily request cap like the OpenRouter free models
# above. Prefer claude-sonnet-5 ($2/$10 per 1M input/output tokens) over claude-haiku-4-5 —
# CrewAI's native Anthropic integration (crewai/llms/providers/anthropic/completion.py) has a
# real bug for a hardcoded list of models that includes claude-haiku-4-5: it sends Anthropic's
# deprecated "output_format" field instead of the current "output_config.format", which hits a
# much stricter schema-complexity limit and fails real requests outright with "Schema is too
# complex." claude-sonnet-5 isn't on that hardcoded list, so it avoids the bug entirely. See
# docs.claude.com/en/docs/about-claude/pricing for current rates before switching this on.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Web search provider used by the Company & Job Discovery agents (tavily.com, free tier)
TAVILY_API_KEY=your_tavily_api_key_here

# Apify (optional) — adds LinkedIn Jobs as an extra job source in the Job Discovery Agent,
# alongside direct company-careers-page discovery. Billed per result by Apify
# (apify.com/pricing) — get a token at apify.com/settings/integrations. Leave unset to skip
# this source entirely (free, no error).
APIFY_API_TOKEN=your_apify_api_token_here

# Database
DATABASE_URL=sqlite:///./storage/data/app.db

# Storage
RESUME_STORAGE_DIR=./storage/resumes

# CORS - frontend origin allowed to call the API
FRONTEND_ORIGIN=http://localhost:5173
